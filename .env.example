# Required for answer generation
GEMINI_API_KEY=
# Qdrant defaults to localhost outside Docker.
# Docker Compose overrides this value with http://qdrant:6333.
QDRANT_URL=http://localhost:6333
# Optional Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Optional Hugging Face access token for higher download limits
HF_TOKEN=
